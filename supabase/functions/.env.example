# Copy to supabase/functions/.env (gitignored) for `pnpm functions`.
# In production: `supabase secrets set ANTHROPIC_API_KEY=...`
ANTHROPIC_API_KEY=
# Pages per account per calendar month (admins are unlimited).
IMPORT_MONTHLY_PAGE_LIMIT=60
IMPORT_MAX_PAGES_PER_CALL=4
# AI profile suggestions per account per month (admins are unlimited).
PROFILE_MONTHLY_LIMIT=50
# In-game narrator answers per account per month (admins are unlimited).
NARRATOR_MONTHLY_LIMIT=300
