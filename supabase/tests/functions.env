# Environment for `pnpm test:import`: a fake key and a fake Claude API (supabase/tests/import-story.test.ts).
# Not a secret. host.docker.internal reaches the test process from the Edge runtime container.
ANTHROPIC_API_KEY=test-key-not-real
ANTHROPIC_BASE_URL=http://host.docker.internal:4010
IMPORT_MONTHLY_PAGE_LIMIT=60
IMPORT_MAX_PAGES_PER_CALL=4
PROFILE_MONTHLY_LIMIT=50
NARRATOR_MONTHLY_LIMIT=300
STORY_CREATE_MONTHLY_LIMIT=10
STORY_OUTLINES_PER_STORY=5
STORY_SCENES_PER_CALL=2
STORY_IDEAS_MONTHLY_LIMIT=50
# MCP connector (supabase/tests/mcp.test.ts): the endpoint and Auth as the test process and MCP clients see them.
MCP_PUBLIC_URL=http://127.0.0.1:54321/functions/v1/mcp
MCP_AUTH_SERVER=http://127.0.0.1:54321/auth/v1
APP_URL=http://127.0.0.1:5173
MCP_STORIES_MONTHLY_LIMIT=5
MCP_EDITS_DAILY_LIMIT=500
