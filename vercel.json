{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/mcp", "destination": "https://fovyhcbasmmstkocavlp.supabase.co/functions/v1/mcp" },
    { "source": "/mcp/.well-known/oauth-protected-resource", "destination": "https://fovyhcbasmmstkocavlp.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "https://fovyhcbasmmstkocavlp.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "git": { "deploymentEnabled": { "main": false } }
}
